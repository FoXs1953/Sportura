# Local development: copy to .env, then `npm run db:up && npm run db:migrate && npm run dev`.
DATABASE_URL=postgres://sportura:sportura@localhost:5432/sportura
APP_URL=http://localhost:3000
FILE_URL_SECRET=local-dev-only
CRON_SECRET=local-dev-only

# Required for email actions; without SMTP_URL they are unavailable.
# Confirmation links are never written to logs. See deploy/staging.env.example.
# SMTP_URL=
# MAIL_FROM=

# Optional Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
