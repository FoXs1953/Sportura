# Template for the STAGING_ENV_FILE GitHub secret. Fill in real values and paste
# the whole text into the secret. Never commit the filled-in version.
# Generate random values in Git Bash: openssl rand -hex 32

# Public hostname; its DNS A record must point at the VPS.
STAGING_DOMAIN=staging.sportura.kz

# PostgreSQL passwords (each: openssl rand -hex 24)
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=

# Signs temporary links to uploaded files (openssl rand -hex 32)
FILE_URL_SECRET=

# Protects /api/public/cron/* (openssl rand -hex 32)
CRON_SECRET=

# Optional: outgoing email for confirmation and password-reset links.
# Without it the links are written to the app log (docker compose logs app).
# SMTP_URL=smtps://user:password@smtp.example.kz:465
# MAIL_FROM=Sportura <no-reply@sportura.kz>

# Optional: Google sign-in. Authorized redirect URI in Google Cloud Console:
# https://staging.sportura.kz/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
