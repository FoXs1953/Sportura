# Template for the STAGING_ENV_FILE GitHub secret. Fill in real values and paste
# the whole text into the secret. Never commit the filled-in version.
# Generate random values in Git Bash: openssl rand -hex 32

# Public hostname; its DNS A record must point at the VPS.
STAGING_DOMAIN=staging.sportura.kz

# PostgreSQL passwords (each: openssl rand -hex 24)
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=

# Signs temporary links to uploaded files (openssl rand -hex 32)
FILE_URL_SECRET=

# Protects /api/public/cron/* (openssl rand -hex 32)
CRON_SECRET=

# Required for registration, confirmation, password reset and email change.
# Without SMTP_URL email actions are unavailable; links are never logged.
# Selected provider: PS.kz. MX/SPF records alone do not create a mailbox.
# Use the full existing mailbox address, URL-encoded credentials, and an
# authorized sender. Install a valid certificate for the mail hostname first;
# TLS on port 465 keeps certificate verification enabled.
# SMTP_URL=smtps://mailbox%40example.kz:URL_ENCODED_PASSWORD@mail.example.kz:465
# MAIL_FROM=Sportura <mailbox@example.kz>

# Optional: Google sign-in. Authorized redirect URI in Google Cloud Console:
# https://staging.sportura.kz/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
